# VoiceBird Environment Variables
# Copy this file to .env and fill in your values (the backend loads .env from
# the project root; docker compose also reads it). Tokens and backend choices
# are read-only from the environment; the UI will not prompt for them.

# ===========================================
# SunbirdAI API Configuration
# ===========================================
# Get your token from https://api.sunbird.ai
NEXT_PUBLIC_SUNBIRD_API_URL=https://api.sunbird.ai
NEXT_PUBLIC_SUNBIRD_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJuZGFoaXJvanVtaWEiLCJhY2NvdW50X3R5cGUiOiJGcmVlIiwiZXhwIjo0OTIxODk2OTMzfQ.2cw0e0xnO6l_rNIYaZzg14vVRw4EwwlqdzqobGg179syour_sunbird_api_token_here

# ===========================================
# Hugging Face API Configuration
# ===========================================
# Get your token from https://huggingface.co/settings/tokens
NEXT_PUBLIC_HF_API_TOKEN=your_huggingface_token_here
HF_TOKEN=your_huggingface_token_here

# Sunbird Models on Hugging Face
# Speech-to-Text (ASR) - Supports: Luganda, Acholi, Ateso, Lugbara, Runyankole, English
NEXT_PUBLIC_HF_ASR_MODEL=Sunbird/sunbird-mms
# Translation (optional cloud mode / reference)
NEXT_PUBLIC_HF_TRANSLATION_MODEL=facebook/nllb-200-distilled-1.3B

# Local translation runtime (backend/translation_server.py)
# Sunbird SALT model: full NLLB-200-3.3B fine-tuned for Luganda, Acholi, Ateso, Lugbara, Runyankole,
# Swahili, Lusoga and Rutooro (more accurate than generic NLLB for those pairs). Not gated on
# Hugging Face; license CC-BY-NC-4.0 (non-commercial).
TRANSLATION_MODEL_ID=Sunbird/translate-nllb-3.3b-salt
TRANSLATION_DEVICE=cpu
TRANSLATION_NUM_BEAMS=4
# Output cap per chunk. Long text is split into token-sized chunks and any chunk
# that still hits this cap is split again and retried, so raise/lower this only
# to trade quality for latency (default 512).
TRANSLATION_MAX_NEW_TOKENS=512
TRANSLATION_PRELOAD_MODEL=true

# ===========================================
# ASR Service Tuning (backend/server.py)
# ===========================================
# faster-whisper (CTranslate2) backend: ~4-10x faster than transformers.
# Custom SALT fine-tunes are converted to CTranslate2 once and cached.
ASR_BACKEND=transformers
# Fixed device for demucs speech separation; set to cpu when the GPU is fully
# used by Whisper (demucs on GPU alongside Whisper large-v3 can OOM an 8GB card).
SPEECH_SEPARATION_DEVICE=cuda
# Speaker diarization (pyannote): requires accepting the gated models
# pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0 on HF.
# DIARIZATION=true
# DIARIZATION_DEVICE=cpu
# DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
# DIARIZATION_TOKEN=  # defaults to HF_TOKEN
# Watch folder: audio files dropped here are transcribed automatically.
# WATCH_FOLDER=/data/watch
# WATCH_OUTPUT_FORMATS=txt,srt,vtt
# OCR option (on-screen text extraction from video): seconds between sampled
# frames, and the cap on frames scanned per video (CPU-bound).
# OCR_FRAME_INTERVAL=1.0
# OCR_MAX_FRAMES=300

# ===========================================
# Local Sunbird Server Configuration (Optional)
# ===========================================
# Run locally with: python backend/server.py
# Uses Sunbird/asr-whisper-large-v3-salt model
NEXT_PUBLIC_LOCAL_SERVER_URL=http://localhost:8100
# Optional local translation endpoint (POST expecting JSON body with text/source_language/target_language)
NEXT_PUBLIC_LOCAL_TRANSLATION_URL=

# ===========================================
# App Configuration
# ===========================================
# Default backend: "sunbird" | "huggingface" | "local"
NEXT_PUBLIC_DEFAULT_BACKEND=local

# ===========================================
# NextAuth.js Configuration
# ===========================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
# Idle session timeout, in minutes (default 30). Stay active and you stay signed
# in; after this much inactivity the session expires and the user has to sign in
# again. Used by both the NextAuth config and the client-side idle sign-out.
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MINUTES=30
